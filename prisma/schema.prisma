// Eensell University — Prisma Schema
// Premium Education Platform Database Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACTIVE_USER
  PENDING_USER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model User {
  id        String     @id @default(cuid())
  clerkId   String     @unique
  email     String     @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  role      UserRole   @default(PENDING_USER)
  status    UserStatus @default(PENDING)
  onboardingCompleted Boolean @default(false)
  goals     String?
  xp        Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  progress       Progress[]
  dailyGoals     Goal[]
  communityPosts CommunityPost[]
  postReactions  PostReaction[]
  postComments   PostComment[]
  notifications  Notification[]
  homeworks      Homework[]
  sessions       UserSession[]
  activities     UserActivity[]
  chatUsages     ChatUsage[]

  @@index([clerkId])
  @@index([status])
  @@index([role])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@index([order])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String?  // Vimeo embed URL
  order       Int      @default(0)
  duration    Int?     // in seconds
  isPublished Boolean  @default(false)
  isFree      Boolean  @default(false)
  requiresHomework Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  resources Resource[]
  progress  Progress[]
  homeworks Homework[]

  @@index([moduleId, order])
}

model Progress {
  id          String   @id @default(cuid())
  isCompleted Boolean  @default(false)
  watchedAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   // "pdf", "template", "prompt", "link"
  fileUrl     String?
  createdAt   DateTime @default(now())

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([type])
}

model LiveCall {
  id          String   @id @default(cuid())
  title       String
  description String?
  scheduledAt DateTime
  meetingUrl  String?
  replayUrl   String?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([scheduledAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  category  String   @default("Learning") // Learning, Review, Practical, Engagement
  date      DateTime @default(now())       // Which day this goal belongs to
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model CommunityPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reactions PostReaction[]
  comments  PostComment[]

  @@index([createdAt])
}

model PostReaction {
  id        String   @id @default(cuid())
  emoji     String   // e.g. "🔥", "❤️", "👏", "💡", "🚀"
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, emoji])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Homework {
  id        String   @id @default(cuid())
  fileUrl   String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([status])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  startTime DateTime @default(now())
  updatedAt DateTime @updatedAt
  totalTime Int      @default(0) // in seconds

  @@unique([userId, date])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  duration  Int      @default(0) // in seconds
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

model ChatUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  count     Int      @default(0)
  month     Int
  year      Int
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([month, year])
}
