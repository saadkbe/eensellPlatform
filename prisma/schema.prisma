// Eensell University — Prisma Schema
// Premium Education Platform Database Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACTIVE_USER
  PENDING_USER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model User {
  id        String     @id @default(cuid())
  clerkId   String     @unique
  email     String     @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  role      UserRole   @default(PENDING_USER)
  status    UserStatus @default(PENDING)
  onboardingCompleted Boolean @default(false)
  hasSeenWalkthrough  Boolean @default(false)
  goals     String?
  xp        Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // ── Expanded onboarding profile fields ──
  phone              String?
  goal               String?   // "learning_ai" | "freelancer" | "agency" | "exploring" | "automations"
  experienceLevel    String?   // "beginner" | "intermediate" | "advanced"
  weeklyHours        String?   // e.g., "1-5h", "5-10h"
  incomeGoal         String?   // "$1K-$3K" | "$3K-$5K" | "$5K-$10K" | "$10K+"
  onboardingStep     Int       @default(1)  // tracks last completed step (1-7) for resume
  challengeStartDate DateTime? // when the 60-day challenge begins for this user
  videoWatchTime     Int       @default(0)  // seconds of welcome video watched

  progress       Progress[]
  dailyGoals     Goal[]
  communityPosts CommunityPost[]
  postReactions  PostReaction[]
  postComments   PostComment[]
  notifications  Notification[]
  homeworks      Homework[]
  sessions       UserSession[]
  activities     UserActivity[]
  chatUsages     ChatUsage[]
  dailyProgresses DailyProgress[]
  missions       Mission[]
  weeklySchedules WeeklySchedule[]

  // ── Referral System ──
  referralCode   String?   @unique
  referredBy     Referral? @relation("Referred")
  referrals      Referral[] @relation("Referrer")
  referralClicks ReferralClick[]
  withdrawals    WithdrawalRequest[]
  payoutInfo     PayoutInfo?

  @@index([clerkId])
  @@index([status])
  @@index([role])
  @@index([status, role])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@index([order])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String?  // Vimeo embed URL
  order       Int      @default(0)
  duration    Int?     // in seconds
  isPublished Boolean  @default(false)
  isFree      Boolean  @default(false)
  requiresHomework Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  resources Resource[]
  progress  Progress[]
  homeworks Homework[]

  @@index([moduleId, order])
  @@index([isPublished, createdAt])
}

model Progress {
  id          String   @id @default(cuid())
  isCompleted Boolean  @default(false)
  watchedAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   // "pdf", "template", "prompt", "link"
  fileUrl     String?
  createdAt   DateTime @default(now())

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([type])
}

model LiveCall {
  id          String   @id @default(cuid())
  title       String
  description String?
  scheduledAt DateTime
  meetingUrl  String?
  replayUrl   String?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([scheduledAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  category  String   @default("Learning") // Learning, Review, Practical, Engagement
  date      DateTime @default(now())       // Which day this goal belongs to
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model CommunityPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reactions PostReaction[]
  comments  PostComment[]

  @@index([createdAt])
}

model PostReaction {
  id        String   @id @default(cuid())
  emoji     String   // e.g. "🔥", "❤️", "👏", "💡", "🚀"
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, emoji])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Homework {
  id        String   @id @default(cuid())
  fileUrl   String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([status])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  startTime DateTime @default(now())
  updatedAt DateTime @updatedAt
  totalTime Int      @default(0) // in seconds

  @@unique([userId, date])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  duration  Int      @default(0) // in seconds
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

model ChatUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  count     Int      @default(0)
  month     Int
  year      Int
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([month, year])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

model Campaign {
  id              String   @id @default(cuid())
  name            String
  startDate       DateTime
  endDate         DateTime
  studentGoal     Int
  pricePerStudent Int
  status          CampaignStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  snapshots       CampaignSnapshot[]

  @@index([status])
}

model CampaignSnapshot {
  id                String   @id @default(cuid())
  date              String   // "YYYY-MM-DD"
  newAccounts       Int      @default(0)
  pendingPayments   Int      @default(0)
  paidStudents      Int      @default(0)
  activatedAccounts Int      @default(0)
  revenue           Int      @default(0)
  runningTotal      Int      @default(0)
  progress          Float    @default(0)
  createdAt         DateTime @default(now())

  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

model DailyProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model WeeklyChallenge {
  id          String   @id @default(cuid())
  title       String
  description String?
  reward      String?
  deadline    DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, deadline])
}

// ══════════════════════════════════════════════
// The Eensell Journey — Onboarding Models
// ══════════════════════════════════════════════

// Admin-managed configuration for each onboarding step
model OnboardingConfig {
  id         String   @id @default(cuid())
  stepNumber Int      @unique    // 1-7
  title      String
  subtitle   String?
  isActive   Boolean  @default(true)
  metadata   String?  // JSON blob for step-specific config (video URL, messages, etc.)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Roadmap milestones displayed in Step 4
model RoadmapMilestone {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?    // emoji or lucide icon name
  weekStart   Int        // e.g., week 1
  weekEnd     Int        // e.g., week 2
  order       Int        @default(0)
  phase       String     // "learn_ai" | "build_skills" | "build_offer" | "build_portfolio" | "first_client" | "scale_business"
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([order])
}

// Student's weekly learning schedule commitment (Step 5)
model WeeklySchedule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  timeBlock String   // "morning" | "afternoon" | "evening"
  createdAt DateTime @default(now())

  @@unique([userId, dayOfWeek])
}

// Student missions auto-generated during onboarding (Step 6)
model Mission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String   // "watch_welcome" | "complete_profile" | "join_community" | "first_lesson"
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isCompleted])
}

// ----------------------------------------------
// Referral & Rewards System
// ----------------------------------------------

model Referral {
  id               String   @id @default(cuid())
  referrerId       String
  referrer         User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId   String   @unique
  referredUser     User     @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  status           String   @default("PENDING") // PENDING, SUCCESSFUL, REJECTED
  commissionAmount Int      @default(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([referrerId])
  @@index([status])
}

model ReferralClick {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([referrerId])
}

model WithdrawalRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  status      String   @default("PENDING") // PENDING, PROCESSING, PAID, REJECTED, CANCELLED
  payoutInfo  Json     // Snapshot of payout details at time of request
  adminNote   String?
  processedBy String?  
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PayoutInfo {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName    String
  accountName String
  rib         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
